-- ========== АВТОФАРМ МОНЕТ ==========
local function autoFarmCoins()
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local coins = {}
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Part") and v.Name == "Coin" then
            table.insert(coins, v)
        end
    end
    for _, coin in pairs(coins) do
        if coin and coin.Position then
            hrp.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2, 0))
            wait(0.15)
        end
    end
end

-- ========== ВИЗУАЛ ==========
local function createHUD()
    local screen = Instance.new("ScreenGui")
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 100)
    frame.Position = UDim2.new(0, 10, 0, 10)
    frame.BackgroundColor3 = Color3.fromRGB(10,10,10)
    frame.BackgroundTransparency = 0.6
    frame.Parent = screen

    local labels = {"Мардер - активен", "Шериф - активен", "Сайлент - активен"}
    for i, text in ipairs(labels) do
        local label = Instance.new("TextLabel")
        label.Text = text
        label.Size = UDim2.new(1, 0, 0, 30)
        label.Position = UDim2.new(0, 0, 0, (i-1)*30)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(0, 255, 0)
        label.TextScaled = true
        label.Parent = frame
    end
    screen.Parent = Player.PlayerGui
end

